   "section_id": "preface-04",
   "kind": "preface",
   "span": [
    574,
    682
   ],
   "cjk": 108,
   "title_zh": "若夫三玄三要奪境奪人金章",
   "head_line": "0495b12",
   "close_line": "0495b18"
  },
  {
   "section_num": 7,
   "section_id": "preface-05",
   "kind": "preface",
   "span": [
    682,
    770
   ],
   "cjk": 88,
   "title_zh": "師之出處具載傳燈等錄茲不",
   "head_line": "0495b18",
   "close_line": "0495b23"
  },
  {
   "section_num": 8,
   "section_id": "preface-06",
   "kind": "preface",
   "span": [
    770,
    861
   ],
   "cjk": 91,
   "title_zh": "今雪堂大禪師臨濟十八代嫡",
   "head_line": "0495b23",
   "close_line": "0495b29"
  },
  {
   "section_num": 9,
   "section_id": "preface-07",
   "kind": "preface",
   "span": [
    861,
    930
   ],
   "cjk": 69,
   "title_zh": "嗚呼雪堂老師行從上祖師難",
   "head_line": "0495b29",
   "close_line": "0495c04"
  },
  {
   "section_num": 10,
   "section_id": "preface-08",
   "kind": "preface",
   "span": [
    930,
    949
   ],
   "cjk": 19,
   "title_zh": "大德二年八月前監察御史郭",
   "head_line": "0495c05",
   "close_line": "0495c06"
  },
  {
   "section_num": 11,
   "section_id": "preface-heading-03",
   "kind": "preface-heading",
   "span": [
    949,
    973
   ],
   "cjk": 24,
   "title_zh": "臨濟慧照玄公大宗師語錄序",
   "head_line": "0495c09",
   "close_line": "0495c09"
  },
  {
   "section_num": 12,
   "section_id": "preface-09",
   "kind": "preface",
   "span": [
    973,
    1065
   ],
   "cjk": 92,
   "title_zh": "竊以黃蘗山高便敢當頭捋虎",
   "head_line": "0495c11",
   "close_line": "0495c16"
  },
  {
   "section_num": 13,
   "section_id": "preface-10",
   "kind": "preface",
   "span": [
    1065,
    1159
   ],
   "cjk": 94,
   "title_zh": "茲者總統雪堂和尚憫巴歌唱",
   "head_line": "0495c16",
   "close_line": "0495c21"
  },
  {
   "section_num": 14,
   "section_id": "preface-11",
   "kind": "preface",
   "span": [
    1159,
    1360
   ],
   "cjk": 201,
   "title_zh": "噫臨濟祖師六傳而至汾陽大",
   "head_line": "0495c21",
   "close_line": "0496a04"
  },
  {
   "section_num": 15,
   "section_id": "preface-12",
   "kind": "preface",
   "span": [
    1360,
    1491
   ],
   "cjk": 131,
   "title_zh": "琅瑘覺傳泐潭月月傳毘陵真",
   "head_line": "0496a04",
   "close_line": "0496a12"
