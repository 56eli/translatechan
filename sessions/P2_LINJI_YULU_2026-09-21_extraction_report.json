   "section_id": "record-24",
   "kind": "record",
   "span": [
    8577,
    8939
   ],
   "cjk": 362,
   "title_zh": "大德山僧如是所舉皆是辨魔",
   "head_line": "0501a15",
   "close_line": "0501b08"
  },
  {
   "section_num": 45,
   "section_id": "record-25",
   "kind": "record",
   "span": [
    8939,
    9052
   ],
   "cjk": 113,
   "title_zh": "大德到這裏學人著力處不通",
   "head_line": "0501b08",
   "close_line": "0501b14"
  },
  {
   "section_num": 46,
   "section_id": "record-26",
   "kind": "record",
   "span": [
    9052,
    9134
   ],
   "cjk": 82,
   "title_zh": "道流一剎那間便入華藏世界",
   "head_line": "0501b14",
   "close_line": "0501b19"
  },
  {
   "section_num": 47,
   "section_id": "record-27",
   "kind": "record",
   "span": [
    9134,
    9296
   ],
   "cjk": 162,
   "title_zh": "道流山僧佛法的的相承從麻",
   "head_line": "0501b19",
   "close_line": "0501b29"
  },
  {
   "section_num": 48,
   "section_id": "record-28",
   "kind": "record",
   "span": [
    9296,
    9727
   ],
   "cjk": 431,
   "title_zh": "但有來求者我即便出看渠渠",
   "head_line": "0501b29",
   "close_line": "0501c25"
  },
  {
