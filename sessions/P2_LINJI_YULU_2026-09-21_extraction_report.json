   "section_id": "preface-13",
   "kind": "preface",
   "span": [
    1491,
    1542
   ],
   "cjk": 51,
   "title_zh": "雪堂禪師乃吾三世祖囑予為",
   "head_line": "0496a12",
   "close_line": "0496a15"
