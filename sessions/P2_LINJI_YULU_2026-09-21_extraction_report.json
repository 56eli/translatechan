   "section_id": "true_person_of_no_rank",
   "kind": "record",
   "span": [
    2254,
    2326
   ],
   "cjk": 72,
   "title_zh": "上堂云赤肉團上有一無位真",
   "head_line": "0496c10",
   "close_line": "0496c14"
  },
  {
   "section_num": 23,
   "section_id": "record-03",
   "kind": "record",
   "span": [
    2326,
    2452
   ],
   "cjk": 126,
   "title_zh": "上堂有僧出禮拜師便喝僧云",
   "head_line": "0496c15",
   "close_line": "0496c22"
  },
  {
   "section_num": 24,
   "section_id": "record-04",
   "kind": "record",
   "span": [
    2452,
    2586
   ],
   "cjk": 134,
   "title_zh": "上堂僧問如何是佛法大意師",
   "head_line": "0496c23",
   "close_line": "0497a01"
  },
  {
   "section_num": 25,
   "section_id": "record-05",
   "kind": "record",
   "span": [
    2586,
    2697
   ],
   "cjk": 111,
   "title_zh": "上堂僧問如何是劍刃上事師",
   "head_line": "0497a02",
   "close_line": "0497a08"
  },
  {
   "section_num": 26,
   "section_id": "record-06",
   "kind": "record",
   "span": [
    2697,
    2743
   ],
   "cjk": 46,
   "title_zh": "上堂云一人在孤峯頂上無出",
   "head_line": "0497a09",
   "close_line": "0497a11"
  },
  {
   "section_num": 27,
   "section_id": "record-07",
   "kind": "record",
   "span": [
    2743,
    2779
   ],
   "cjk": 36,
   "title_zh": "上堂云有一人論劫在途中不",
   "head_line": "0497a12",
   "close_line": "0497a14"
  },
  {
   "section_num": 28,
   "section_id": "record-08",
   "kind": "record",
   "span": [
    2779,
    2883
   ],
   "cjk": 104,
   "title_zh": "上堂僧問如何是第一句師云",
   "head_line": "0497a15",
   "close_line": "0497a21"
  },
  {
   "section_num": 29,
   "section_id": "record-09",
   "kind": "record",
   "span": [
    2883,
    3917
   ],
   "cjk": 1034,
   "title_zh": "師晚參示眾云有時奪人不奪",
   "head_line": "0497a22",
   "close_line": "0497c25"
  },
  {
   "section_num": 30,
   "section_id": "record-10",
   "kind": "record",
   "span": [
    3917,
    4225
   ],
   "cjk": 308,
   "title_zh": "師示眾云道流切要求取真正",
   "head_line": "0497c26",
   "close_line": "0498a15"
  },
  {
   "section_num": 31,
   "section_id": "record-11",
   "kind": "record",
   "span": [
    4225,
    4463
   ],
   "cjk": 238,
   "title_zh": "師示眾云道流佛法無用功處",
   "head_line": "0498a16",
   "close_line": "0498b01"
  },
  {
   "section_num": 32,
   "section_id": "record-12",
   "kind": "record",
   "span": [
    4463,
    4835
   ],
   "cjk": 372,
   "title_zh": "問如何是佛魔師云爾一念心",
   "head_line": "0498b02",
   "close_line": "0498b24"
  },
  {
   "section_num": 33,
   "section_id": "record-13",
   "kind": "record",
   "span": [
    4835,
    5200
   ],
   "cjk": 365,
   "title_zh": "問如何是真正見解師云爾但",
   "head_line": "0498b25",
   "close_line": "0498c17"
  },
  {
   "section_num": 34,
   "section_id": "record-14",
   "kind": "record",
   "span": [
    5200,
    5452
   ],
   "cjk": 252,
   "title_zh": "問如何是四種無相境師云爾",
   "head_line": "0498c18",
   "close_line": "0499a03"
  },
  {
   "section_num": 35,
   "section_id": "record-15",
   "kind": "record",
   "span": [
    5452,
    5845
   ],
   "cjk": 393,
   "title_zh": "師示眾云如今學道人且要自",
