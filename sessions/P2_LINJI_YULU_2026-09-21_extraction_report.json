   "section_id": "record-23",
   "kind": "record",
   "span": [
    8282,
    8577
   ],
   "cjk": 295,
   "title_zh": "道流大丈夫漢更疑箇什麼目",
   "head_line": "0500c27",
   "close_line": "0501a15"
  },
  {
