   "flagged": [
    {
     "path": ".title_zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "德山宣鑑禪師語錄德山棒與焚經",
     "ref_window": "",
     "simplified": [],
     "also_in": null
    },
    {
     "path": ".sections[0].title_zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "婆子點心過去心不可得點那箇心",
     "ref_window": "",
     "simplified": [],
     "also_in": null
    },
    {
     "path": ".sections[0].dialogue[0].zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "師初講金剛經著青龍疏鈔自負無比聞南方禪道大振乃擔疏鈔南下路上見一婆子賣點心遂歇擔買餅",
     "ref_window": "",
     "simplified": [],
     "also_in": null
    },
    {
     "path": ".sections[0].dialogue[1].zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "婆問車上挑得是甚麼文字師曰金剛經疏鈔婆曰我有一問若答得施與點心若答不得且請他去",
     "ref_window": "",
     "simplified": [],
     "also_in": null
    },
    {
     "path": ".sections[0].dialogue[2].zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "婆曰金剛經道過去心不可得現在心不可得未來心不可得未審長老點那箇心師無對",
     "ref_window": "",
     "simplified": [],
     "also_in": null
    },
    {
     "path": ".sections[1].title_zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "龍潭吹滅紙燭大悟焚經",
     "ref_window": "",
     "simplified": [],
     "also_in": null
    },
    {
     "path": ".sections[1].dialogue[0].zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "師至龍潭夜深侍立龍潭曰更深何不下去師遂出復回曰外面黑龍潭點紙燭度與師師擬接龍潭復吹滅師於此大悟便禮拜",
     "ref_window": "",
     "simplified": [],
     "also_in": null
    },
    {
     "path": ".sections[1].dialogue[1].zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "次日師提疏鈔於法堂前舉火炬曰窮諸玄辯若一毫置於太虛竭世樞機似一滴投於巨壑遂焚之",
     "ref_window": "",
     "simplified": [],
     "also_in": null
    },
    {
     "path": ".sections[2].title_zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "德山棒道得也三十棒道不得也三十棒",
     "ref_window": "",
     "simplified": [],
     "also_in": null
    },
    {
     "path": ".sections[2].dialogue[0].zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "師示眾云問即有過不問猶乖道得也三十棒道不得也三十棒汝等速道速道",
     "ref_window": "",
     "simplified": [],
     "also_in": null
    }
   ],
