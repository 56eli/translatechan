   "fields_total": 8,
   "content_fields_total": 4,
   "content_fields_collated": 0,
   "metadata_fields_total": 4,
   "flagged": [
    {
     "path": ".sections[0].title_zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "嶺南市井忽聞客誦金剛經",
     "ref_window": "",
     "simplified": []
    },
    {
     "path": ".sections[0].dialogue[0].zh",
     "class": "NOT_FOUND",
     "sim": 0.2429,
     "ref": "X86n1598",
     "corpus": "祖幼孤貧採薪鬻市一日負薪至市見一客誦經祖忽聞應無所住而生其心言下大悟遂問客誦何經客曰金剛般若波羅蜜經五祖弘忍大師於黃梅所授也祖遂辭母直指黃梅",
     "ref_window": "記曰三鼓入室祖以袈裟遮圍不令人見為說金剛經至應無所住而生其心言下大悟今謂若不曾聞經於市開悟豈往黃梅見五祖酬問如流哉況自復言米熟久矣唯欠篩耳如",
     "simplified": []
    },
    {
     "path": ".sections[1].title_zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "黃梅初見五祖人有南北佛性無南北",
     "ref_window": "",
     "simplified": []
    },
    {
     "path": ".sections[1].dialogue[0].zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "五祖見祖問曰汝自何來祖曰嶺南新州百姓祖曰汝來求何事六祖曰唯求作佛不求餘物",
     "ref_window": "",
     "simplified": []
    },
    {
     "path": ".sections[1].dialogue[1].zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "五祖曰汝是嶺南獦獠若為堪得作佛六祖曰人雖有南北佛性本無南北獦獠身與和尚身不同佛性有何差別五祖知其異人叱令隨眾作務",
     "ref_window": "",
     "simplified": []
    },
    {
     "path": ".sections[2].title_zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "隱於獵人隊十五年肉邊菜",
     "ref_window": "",
     "simplified": []
    },
    {
     "path": ".sections[2].dialogue[0].zh",
     "class": "NOT_FOUND",
     "sim": 0.0,
     "ref": null,
     "corpus": "六祖得衣鉢後南下避難隱於四會懷集獵人隊中十五載每於獵人守網之際隨宜放生每至飯時以菜寄煮肉鍋人問其故祖曰但喫肉邊菜迨至時至機熟乃出廣州法性寺開演頓教法門",
     "ref_window": "",
     "simplified": []
    }
   ],
